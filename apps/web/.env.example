# mock = in-browser seeded demo data (default); http = API Gateway backend
VITE_DATA_SOURCE=mock
VITE_API_URL=
# Dev only: with VITE_API_URL=/api, the dev server forwards /api here
API_PROXY_TARGET=
# With http: Cognito ids from the stack outputs (UserPoolId, UserPoolClientId)
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
